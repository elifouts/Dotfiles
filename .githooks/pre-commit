#!/bin/bash
cd "$(git rev-parse --show-toplevel)"
src="${WALLPAPER_LIBRARY:-$HOME/wallpapers/library}" dst=wallpapers/library
[[ -f $src/favorites.txt ]] || exit 0

mkdir -p "$dst"
find "$dst" -mindepth 2 -type f | sed "s|^$dst/||" | grep -vxFf "$dst/favorites.txt" | sed "s|^|$dst/|" | xargs -r -d '\n' rm --
while read -r f; do [[ -f $src/$f ]] && install -CDm644 "$src/$f" "$dst/$f"; done < "$dst/favorites.txt"
find "$dst" -mindepth 1 -type d -empty -delete
git add -A "$dst"
