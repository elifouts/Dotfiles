{
  "animation": {
    "curve": [
      0.3,
      1,
      0.4,
      1
    ],
    "preset": "snappy",
    "speed": 1.7,
    "window": "popin 60%",
    "workspace": "slide"
  },
  "bar": {
    "kind": "quickshell"
  },
  "colors": {
    "theme": "dark/catppuccin-macchiato-copy"
  },
  "config": {
    "animations": {
      "enabled": true
    },
    "decoration": {
      "active_opacity": 0.76,
      "dim_inactive": true,
      "dim_strength": 0.25,
      "glow": {
        "enabled": false
      },
      "inactive_opacity": 1,
      "motion_blur": {
        "enabled": false
      },
      "rounding": 3,
      "rounding_power": 5,
      "shadow": {
        "enabled": true,
        "range": 1,
        "render_power": 4,
        "scale": 1,
        "sharp": true
      }
    },
    "general": {
      "border_size": 0,
      "gaps_in": 11,
      "gaps_out": 0,
      "gaps_workspaces": 0
    }
  },
  "quickshell": {
    "style": "full"
  },
  "wallpaper": {
    "path": "$HOME/wallpapers/library/catppuccin/cat-02.jpg"
  },
  "waybar": {
    "style": "default"
  }
}
