{
  "animation": {
    "curve": [
      0.3,
      1,
      0.4,
      1
    ],
    "preset": "snappy",
    "speed": 2.5,
    "window": "popin 60%",
    "workspace": "slide"
  },
  "bar": {
    "kind": "quickshell"
  },
  "colors": {
    "theme": "pywal"
  },
  "config": {
    "decoration": {
      "active_opacity": 1,
      "blur": {
        "brightness": 0.75,
        "enabled": true,
        "passes": 6,
        "size": 20,
        "vibrancy": 0.4
      },
      "dim_inactive": true,
      "dim_strength": 0.25,
      "glow": {
        "enabled": false
      },
      "inactive_opacity": 1,
      "motion_blur": {
        "enabled": false
      },
      "rounding": 0,
      "rounding_power": 5,
      "shadow": {
        "enabled": true,
        "range": 1,
        "render_power": 4,
        "scale": 1,
        "sharp": true
      }
    },
    "general": {
      "border_size": 0,
      "gaps_in": 2,
      "gaps_out": 0,
      "gaps_workspaces": 0
    }
  },
  "quickshell": {
    "style": "experimental"
  },
  "wallpaper": {
    "path": "$HOME/wallpapers/library/catppuccin/cat-05.jpg"
  },
  "waybar": {
    "style": "default"
  }
}
